    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "security-tools": {
      "type": "local",
      "command": ["python3", "/home/naveenkumar/.config/opencode/mcp/security-tools/server.py"],
