      "model": "anthropic/claude-sonnet-4-6",
      "color": "#0000ff",
      "permission": {
        "edit": "deny",
        "bash": { "subfinder": "allow", "httpx": "allow", "naabu": "allow", "dnsx": "allow", "nmap": "allow", "katana": "allow", "curl": "allow", "wget": "allow", "*": "allow" }
      }
    },
    "webapp": {
      "description": "Web application security specialist for OWASP Top 10 testing, fuzzing, injection attacks.",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6",
      "color": "#00ff00",
      "permission": {
        "edit": "deny",
        "bash": { "ffuf": "allow", "nuclei": "allow", "sqlmap": "allow", "nikto": "allow", "curl": "allow", "python3": "allow", "*": "allow" }
