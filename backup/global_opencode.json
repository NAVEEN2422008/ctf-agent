    "verify": { "description": "Run full verification matrix", "agent": "ghost-operator", "template": "opencode agent verify" },
    "full-pentest": { "description": "Complete penetration test workflow", "agent": "ghost-operator", "template": "opencode agent full-pentest {target}" },
    "pivot-setup": { "description": "Setup chisel/ligolo pivoting", "agent": "exploit", "template": "opencode agent pivot-setup {target}" },
    "ad-enum": { "description": "Active Directory enumeration", "agent": "exploit", "template": "opencode agent ad-enum {domain}" },
    "cloud-enum": { "description": "Cloud resource enumeration", "agent": "cloud", "template": "opencode agent cloud-enum {provider}" },
