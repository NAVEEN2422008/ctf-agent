    "ctf-pwn-rev": { "description": "CTF pwn/reverse engineering", "agent": "ctf-pwn-rev", "template": "opencode agent ctf-pwn-rev {target}" },
    "ctf-crypto": { "description": "CTF cryptanalysis", "agent": "ctf-crypto", "template": "opencode agent ctf-crypto {ciphertext}" },
    "ctf-forensics": { "description": "CTF forensic analysis", "agent": "ctf-forensics", "template": "opencode agent ctf-forensics {evidence}" },
    "ctf-worker-dispatch": { "description": "CTF worker dispatch (Tailscale funnel)", "agent": "ctf-worker-dispatch", "template": "opencode agent ctf-worker-dispatch {command}" }
