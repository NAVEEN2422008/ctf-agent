      "model": "opencode/big-pickle",
      "color": "#ff0000",
      "steps": 50,
      "options": { "temperature": 0.3, "top_p": 0.9 },
      "permission": { "edit": "allow", "bash": { "*": "allow" } }
    },
    "autonomous-hacker": {
      "description": "Fully autonomous elite offensive security engineer with self-configuration and verification capabilities.",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6",
      "color": "#ff4444",
      "permission": { "edit": "allow", "bash": { "*": "allow" } }
    },
    "security-auditor": {
      "description": "Advanced ethical hacker and security analysis agent for vulnerability assessments and code hardening.",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6",
      "color": "#ff8800",
      "permission": { "edit": "allow", "bash": { "*": "allow" } }
    },
    "recon": {
