      "color": "#ff0000",
      "permission": { "edit": "allow", "bash": { "msfconsole": "allow", "msfvenom": "allow", "netexec": "allow", "chisel": "allow", "ligolo-ng": "allow", "responder": "allow", "python3": "allow", "ssh": "allow", "*": "allow" } }
