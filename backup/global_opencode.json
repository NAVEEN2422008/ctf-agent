{
  "$schema": "https://opencode.ai/config.json",
  "username": "naveenkumar",
  "model": "anthropic/claude-sonnet-4-6",
  "small_model": "anthropic/claude-sonnet-4-6",
  "default_agent": "ghost-operator",
  "shell": "/bin/zsh",
  "logLevel": "WARN",
  "share": "disabled",
  "autoupdate": false,
  "snapshot": true,

  "instructions": ["AGENTS.md"],

  "skills": {
    "paths": [".opencode/skills", "~/.config/opencode/skills"]
